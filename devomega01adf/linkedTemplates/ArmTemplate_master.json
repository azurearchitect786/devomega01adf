{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "devomega01adf"
		},
		"LS_AzureSQLClass_Parameterized_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-server-etnd-7682.database.windows.net"
		},
		"LS_AzureSQLClass_Parameterized_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().DBName}"
		},
		"LS_CosmosClass_Parameterized_properties_typeProperties_accountEndpoint": {
			"type": "string",
			"defaultValue": "https://cosmosadflabs.documents.azure.com:443/"
		},
		"LS_CosmosClass_Parameterized_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().CosmosDBName}"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "devomega01adf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AzureSQLClass_Parameterized_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQLClass_Parameterized_properties_typeProperties_server')]"
					},
					"LS_AzureSQLClass_Parameterized_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQLClass_Parameterized_properties_typeProperties_database')]"
					},
					"LS_CosmosClass_Parameterized_properties_typeProperties_accountEndpoint": {
						"value": "[parameters('LS_CosmosClass_Parameterized_properties_typeProperties_accountEndpoint')]"
					},
					"LS_CosmosClass_Parameterized_properties_typeProperties_database": {
						"value": "[parameters('LS_CosmosClass_Parameterized_properties_typeProperties_database')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}